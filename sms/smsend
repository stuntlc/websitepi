#!/bin/bash

NUMBER="$1"
MESSAGE="$2"

ADB="${ADB:-adb}"
COMPOSE_X="${SMS_COMPOSE_X:-340}"
COMPOSE_Y="${SMS_COMPOSE_Y:-1419}"
SEND_X="${SMS_SEND_X:-648}"
SEND_Y="${SMS_SEND_Y:-1419}"
WAIT_AFTER_LAUNCH="${SMS_WAIT_AFTER_LAUNCH:-2}"
WAIT_AFTER_INPUT="${SMS_WAIT_AFTER_INPUT:-1}"

run_adb() {
    if ! "$ADB" "$@"; then
        echo "ADB command failed: $*"
        exit 1
    fi
}

cleanup_messaging() {
    "$ADB" shell am force-stop com.android.messaging >/dev/null 2>&1 || true
}

tap_send_button() {
    local ui_xml node node_lc bounds left top right bottom

    if "$ADB" shell uiautomator dump /sdcard/sms-window.xml >/dev/null 2>&1; then
        ui_xml=$("$ADB" shell cat /sdcard/sms-window.xml 2>/dev/null | tr -d '\r')
        while IFS= read -r node; do
            node_lc=${node,,}
            if [[ "$node_lc" == *'text="send'* || "$node_lc" == *'content-desc="send'* || "$node_lc" == *'resource-id="'*send* ]]; then
                bounds=$(printf '%s' "$node" | sed -n 's/.*bounds="\[\([0-9]*\),\([0-9]*\)\]\[\([0-9]*\),\([0-9]*\)\]".*/\1 \2 \3 \4/p')
                if read -r left top right bottom <<< "$bounds"; then
                    run_adb shell input tap "$(((left + right) / 2))" "$(((top + bottom) / 2))"
                    echo "Send button tapped at $(((left + right) / 2)),$(((top + bottom) / 2))."
                    return
                fi
            fi
        done < <(printf '%s' "$ui_xml" | sed 's/></>\n</g')
    fi

    run_adb shell input tap "$SEND_X" "$SEND_Y"
    echo "Send button tapped at fallback coordinates $SEND_X,$SEND_Y."
}

if [ -z "$NUMBER" ] || [ -z "$MESSAGE" ]; then
    echo "Usage: $0 <number> <message>"
    exit 1
fi

NUMBER=$(printf '%s' "$NUMBER" | sed -E 's/[[:space:]().-]//g; s/^00/+/')
if [[ "$NUMBER" =~ ^0[1-9][0-9]{8}$ ]]; then
    NUMBER="+32${NUMBER:1}"
fi
if ! [[ "$NUMBER" =~ ^\+[1-9][0-9]{6,14}$ ]]; then
    echo "Invalid international phone number: $NUMBER"
    exit 1
fi
if printf '%s' "$MESSAGE" | LC_ALL=C grep -q '[^ -~]'; then
    echo "Unsupported character. SMS text must use standard keyboard characters."
    exit 1
fi

trap cleanup_messaging EXIT

echo "Sending SMS to $NUMBER: $MESSAGE"

run_adb wait-for-device

ENCODED_MESSAGE=${MESSAGE//%/%25}
ENCODED_MESSAGE=${ENCODED_MESSAGE// /%s}

REMOTE_MESSAGE=$(printf '%s' "$ENCODED_MESSAGE" | sed "s/'/'\\\\''/g")

# Reset Messaging
run_adb shell am force-stop com.android.messaging
sleep 1

# Open compose window
run_adb shell am start -W -a android.intent.action.SENDTO -d "sms:$NUMBER"
sleep "$WAIT_AFTER_LAUNCH"

# Tap compose box
run_adb shell input tap "$COMPOSE_X" "$COMPOSE_Y"
sleep "$WAIT_AFTER_INPUT"

run_adb shell input keyevent KEYCODE_MOVE_END
for ((delete_index = 0; delete_index < 40; delete_index++)); do
    run_adb shell input keyevent --longpress KEYCODE_DEL
done

# Type message
run_adb shell "input text '$REMOTE_MESSAGE'"
sleep "$WAIT_AFTER_INPUT"

# CLOSE KEYBOARD (critical!)
run_adb shell input keyevent KEYCODE_BACK
sleep "$WAIT_AFTER_INPUT"

# Tap SEND button
tap_send_button
sleep "$WAIT_AFTER_LAUNCH"

# Close conversation
run_adb shell input keyevent KEYCODE_BACK
sleep "$WAIT_AFTER_INPUT"

echo "SMS sent successfully."
