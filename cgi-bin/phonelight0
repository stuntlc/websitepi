#!/bin/bash
if output=$(adb shell "echo 0 > /sys/class/leds/flashlight/brightness" 2>&1); then
    printf 'Content-Type: text/plain\n\nFlashlight OFF\n'
else
    printf 'Status: 500 Internal Server Error\nContent-Type: text/plain\n\nERROR: Flashlight could not turn off: %s\n' "$output"
    exit 1
fi
