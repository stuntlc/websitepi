#!/bin/bash
if output=$(/bin/bash "$(dirname "$0")/../piscripts/fmradiophone" 2>&1); then
    printf 'Content-Type: text/plain\n\nFM Radio ON (speaker enabled)\n'
else
    printf 'Status: 500 Internal Server Error\nContent-Type: text/plain\n\nERROR: FM radio command failed: %s\n' "$output"
    exit 1
fi
